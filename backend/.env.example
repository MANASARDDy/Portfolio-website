# =============================================================================
# Portfolio Backend Environment Variables Template
# Copy this file to .env and fill in your actual configuration
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5500

# Gmail SMTP Email Configuration (Nodemailer)
# Note: Google requires 2-Step Verification and a 16-character App Password
# (Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
CONTACT_RECEIVER=reddymanasa0271@gmail.com

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=portfolio_db
DB_CONNECTION_LIMIT=10

# Security & CORS
# Comma-separated list of allowed frontend origins (e.g., Live Server, Vite, file preview)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Administrative API Authentication Key
# Used to authenticate GET /api/contact via Header: x-api-key or Authorization: Bearer <key>
ADMIN_API_KEY=your_secure_admin_api_key_here
